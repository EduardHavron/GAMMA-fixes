--[[
  zz Task Generation Speed Fix (FX-TGEN, specs/fixes/fx-tgen.md) - entry point.
  Install on the host and the peer; it works where tasks are generated (the host, or solo).

  Problem: every task generation (a Taskboard refresh, opening a dialog) checks every task's precondition again for
  every NPC, and three task types look for a target by checking all 65534 server objects of the world, every time.
  A refresh costs seconds.

  The fix has four independent parts. Each one patches a function of another mod; when that mod is missing or
  changed, the part skips itself and writes one line to the log, and the other parts still work.
    memo      zz_xrrfix_tgen_memo.script      Answers repeated precondition checks of the same task from memory
                                              for 5 s instead of computing them again for each NPC.
    bounty    zz_xrrfix_tgen_bounty.script    PDA Taskboard Redesign's search for bounty targets reads the shared
                                              world snapshot instead of scanning the world per task.
    measure   zz_xrrfix_tgen_measure.script   The measurement task's search for an anomaly reads the snapshot.
    delivery  zz_xrrfix_tgen_delivery.script  The delivery task's search for a courier target reads the snapshot.
  Shared by the parts:
    zz_xrrfix_tgen_snapshot.script   The world snapshot: one scan of all server objects at most every 5 s; while
                                     scanning, every part picks the objects it needs into its own list.
    zz_xrrfix_tgen_hooks.script      Finding a function of another mod (also behind other mods' wrappers) and
                                     putting a replacement exactly where it was.
    zz_xrrfix_tgen_measure_copy.script, zz_xrrfix_tgen_delivery_copy.script
                                     Verbatim copies of the two replaced functions; only their world scan differs.
  zz_xrrfix_tgen_prof.script is a separate diagnostic (timings in the log); it reads take_stats below.

  Workflow - who calls what:
    Game start
      on_game_start (this file), for each part in PARTS order, under pcall:
        zz_xrrfix_tgen_memo.install      puts memo's wrapper on xr_conditions.has_completed_task_prerequisites
        zz_xrrfix_tgen_bounty.install    puts its build_variants into z_taskboard_bounty_variants
                                         and registers the "bounty" collector in the snapshot
        zz_xrrfix_tgen_measure.install   puts the copy from zz_xrrfix_tgen_measure_copy in place of the original
                                         validate_measure_task and registers the "measure" collector
        zz_xrrfix_tgen_delivery.install  the same for on_init_delivery_task and the "delivery" collector
      then registers forget_everything for on_level_changing (once).
    Task generation (axr_task_manager.generate_available_tasks, for each NPC whose tasks are listed)
      has_completed_task_prerequisites(nil, nil, {task_id})
        -> memo's wrapper: an answer younger than 5 s is returned from memory; otherwise the original runs.
           The original may call validate_measure_task -> measure copy -> zz_xrrfix_tgen_snapshot.entries("measure").
      setup_bounty_task -> variant_list -> build_variants -> bounty -> zz_xrrfix_tgen_snapshot.entries("bounty")
      on_init_delivery_task -> delivery copy -> zz_xrrfix_tgen_snapshot.entries("delivery")
      zz_xrrfix_tgen_snapshot.entries scans the world only when the last scan is older than 5 s; one scan fills the
      lists of all three parts.
    Level change
      on_level_changing -> forget_everything -> zz_xrrfix_tgen_memo.forget, zz_xrrfix_tgen_snapshot.forget
    Profiler
      zz_xrrfix_tgen_prof calls take_stats after each burst of task generation.

  Every part module has install() with the same results:
    true, message   the part was installed now; message is its log marker
    true            it was already installed (a second on_game_start), nothing to log
    false, message  it was skipped; message says why
]]

-- Part name (used in "<name> install error" lines) and the module that installs it, in install order.
local PARTS = {
	{ name = "memo", module = "zz_xrrfix_tgen_memo" },
	{ name = "bounty", module = "zz_xrrfix_tgen_bounty" },
	{ name = "measure", module = "zz_xrrfix_tgen_measure" },
	{ name = "delivery", module = "zz_xrrfix_tgen_delivery" },
}

local function log(message) printf("%s", "[XRRFIX] tgen: " .. message) end

-- Calls module_name's take_counters(); a function so that take_counters_of can pcall it.
local function call_take_counters(module_name)
	return _G[module_name].take_counters()
end

-- module_name's take_counters() result, or nil when the module did not load (any error is swallowed).
local function take_counters_of(module_name)
	local no_error, counters = pcall(call_take_counters, module_name)
	return no_error and type(counters) == "table" and counters or nil
end

--[[ take_stats() -> counters
  What the fix saved since the previous call, for the profiler's summary line; starts counting again from zero.
  Returns { hits, misses, built, reused }:
    hits   - precondition checks answered from memo's memory
    misses - precondition checks that ran the original (and were remembered, unless the task depends on the NPC)
    built  - world scans made by the snapshot
    reused - requests answered from an existing snapshot without a scan
  A module that failed to load counts as zero, so the profiler (which calls this without pcall, from
  actor_on_update) never fails because of it.
  Called by zz_xrrfix_tgen_prof.report after each burst of task generation.
]]
function take_stats()
	local memo_counters = take_counters_of("zz_xrrfix_tgen_memo") or { hits = 0, misses = 0 }
	local snapshot_counters = take_counters_of("zz_xrrfix_tgen_snapshot") or { built = 0, reused = 0 }
	return {
		hits = memo_counters.hits,
		misses = memo_counters.misses,
		built = snapshot_counters.built,
		reused = snapshot_counters.reused,
	}
end

--[[ forget_everything()
  Drops the remembered precondition answers and the world snapshot: after a level change the objects, their levels
  and the dialog NPCs are different, so nothing from the previous level may be reused.
  Registered for on_level_changing by on_game_start.
]]
local function forget_everything()
	zz_xrrfix_tgen_memo.forget()
	zz_xrrfix_tgen_snapshot.forget()
end

-- Runs part.module's install() (see the header); a function so that on_game_start can pcall it.
local function install_part(part)
	return _G[part.module].install()
end

--[[ on_game_start()
  Installs the four parts in PARTS order and logs each result: the marker of a fresh install, the reason of a skip,
  or "<part> install error: <error>" when an install fails (the other parts are installed anyway). A second call
  (another game start in the same session) finds the parts installed and logs nothing.
  Called by the game (axr_main) once per game start, for every script that has on_game_start.
]]
function on_game_start()
	for _, part in ipairs(PARTS) do
		local no_error, result, message = pcall(install_part, part)
		if not no_error then
			log(part.name .. " install error: " .. tostring(result)) -- result is the error text here
		elseif message then
			log(message)
		end
	end
	if not __xrrfix_tgen_cb then
		__xrrfix_tgen_cb = true
		RegisterScriptCallback("on_level_changing", forget_everything)
	end
end
