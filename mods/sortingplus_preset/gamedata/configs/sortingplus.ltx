
;Change this table to change how things are sorted when not using AMCM or when "Use sortingplus.ltx" is checked in the AMCM menu.

[item_kind_order]
; Scale = original order x10, so new sub-kinds fit between the old categories as integers.
favorites           = -20 ;custom category items set to via key bind
loadout				= -10 ;support for ARM
mags				= 0  ;support for ARM
w_sniper            = 10
w_rifle             = 10
w_smg               = 10
w_shotgun           = 10
