	<string id="ui_mcm_menu_qct">
		<text>Quantity Craft and Transfer</text>
	</string>
	<string id="ui_mcm_qct_desc">
		<text>Fenêtre "Combien ?" pour fabriquer à l'établi et déplacer des piles dans les caches et le commerce. S'ouvre depuis le menu du clic droit ou avec le raccourci ci-dessous. Les modificateurs cochés doivent être maintenus, les autres non : Y, Alt+Y et Ctrl+Shift+Y sont donc des raccourcis différents.</text>
	</string>
